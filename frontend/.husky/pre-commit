#!/usr/bin/env sh

# Run type-check and lint in frontend before committing.
# core.hooksPath is frontend/.husky/_; git cwd is repo root.
cd frontend || exit 1

echo "Running TypeScript check..."
npm run type-check
if [ $? -ne 0 ]; then
  echo "TypeScript check failed. Please fix errors before committing."
  exit 1
fi

echo "Running lint-staged..."
npx lint-staged
